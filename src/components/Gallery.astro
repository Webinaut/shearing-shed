---
import { Image } from "astro:assets";
import "swiper/css";
import "swiper/css/pagination";
import "swiper/css/autoplay";
import "swiper/css/effect-flip";
import "../styles/my-swiper-styles.scss";

const images = import.meta.glob<{ default: ImageMetadata }>(
  "../images/gallery/*.{jpeg,jpg,png,gif,webp}",
  { eager: true },
);

const imageList = Object.entries(images).map((entry) => {
  const path = entry.at(0) as string;
  const image = entry.at(1) as { default: ImageMetadata };
  const fileName =
    path.split("/").pop()?.split(".").slice(0, -1).join(".") || "";
  const title = fileName
    .split("-")
    .map((word: string) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(" ");

  return {
    path,
    alt: title,
    src: image.default,
  };
});
---

<div class="swiper gallery-swiper">
  <div class="swiper-wrapper">
    {imageList.map((image, index) => (
      <div class="swiper-slide">
        <Image
          src={image.src}
          alt={image.alt}
          widths={[480, 800, 1200]}
          sizes="(max-width: 768px) 95vw, 80vw"
          loading={index === 0 ? "eager" : "lazy"}
          fetchpriority={index === 0 ? "high" : "auto"}
        />
      </div>
    ))}
  </div>
  <div class="swiper-pagination"></div>
</div>

<script>
  import Swiper from "swiper";
  import { Autoplay, Pagination, EffectFlip, Keyboard } from "swiper/modules";

  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  new Swiper(".gallery-swiper", {
    modules: [Autoplay, Pagination, EffectFlip, Keyboard],
    loop: true,
    slidesPerView: 1,
    speed: prefersReducedMotion ? 0 : 1000,
    effect: prefersReducedMotion ? "slide" : "flip",
    grabCursor: true,
    keyboard: {
      enabled: true,
    },
    autoplay: prefersReducedMotion
      ? false
      : {
          delay: 3000,
          disableOnInteraction: false,
        },
    pagination: {
      el: ".gallery-swiper .swiper-pagination",
      type: "bullets",
      clickable: true,
    },
  });
</script>

<style lang="scss">
  .gallery-swiper .swiper-slide {
    display: flex;
    justify-content: center;
    align-items: center;

    & img {
      display: block;
      width: auto;
      max-width: 100%;
      height: 72vh;
      object-fit: cover;
      border-radius: 10px;
    }
  }
</style>
